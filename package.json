{
	"name": "better-connect",
	"version": "0.2.0",
	"description": "Multi-chain Connect authentication for Better Auth",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bchainhub/better-connect.git"
	},
	"files": [
		"dist",
		"test/fixtures/conformance.json",
		"docs",
		"LICENSE",
		"README.md",
		"test/fixtures/wallet-validation.json"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		}
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "node scripts/clean.mjs && tsc",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"lint": "eslint src && prettier --check src test scripts examples package.json tsconfig.json eslint.config.js --ignore-unknown --no-error-on-unmatched-pattern",
		"test": "npm run build && node --test test/*.test.mjs",
		"prepublishOnly": "npm run build",
		"format": "prettier --write src test scripts examples package.json tsconfig.json eslint.config.js --ignore-unknown --no-error-on-unmatched-pattern",
		"test:package": "npm run build && node scripts/package-smoke.mjs"
	},
	"devDependencies": {
		"@emurgo/cardano-message-signing-nodejs": "^1.1.0",
		"@types/node": "^22.20.5",
		"better-auth": "^1.7.14",
		"better-sqlite3": "^13.0.3",
		"bitcoinjs-message": "^2.2.0",
		"eslint": "^10.14.0",
		"prettier": "^3.9.10",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"tronweb": "^6.5.1"
	},
	"dependencies": {
		"@better-fetch/fetch": "^1.3.3",
		"blockchain-wallet-validator": "1.2.1",
		"monero-ts": "^0.11.21",
		"zod": "^4.6.7",
		"@scure/base": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"bip322-js": "^4.0.0",
		"@stellar/stellar-sdk": "^17.4.0",
		"ripple-keypairs": "^3.1.0",
		"cborg": "^6.2.1",
		"viem": "^2.57.13",
		"@noble/curves": "^2.4.0",
		"bitcoinjs-lib": "7.0.1",
		"ethers": "^6.17.0"
	},
	"peerDependencies": {
		"better-auth": "^1.7.14"
	},
	"bundleDependencies": [
		"monero-ts",
		"bip322-js",
		"bitcoinjs-lib"
	],
	"overrides": {
		"minimatch": "^11.0.3",
		"tronweb": {
			"axios": "1.21.0"
		}
	}
}
