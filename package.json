{
	"name": "better-connect",
	"version": "0.1.3",
	"description": "Multi-chain Connect authentication for Better Auth",
	"type": "module",
	"license": "SEE LICENSE IN LICENSE",
	"repository": {
		"type": "git",
		"url": "https://github.com/bchainhub/better-connect.git"
	},
	"files": [
		"dist",
		"test/fixtures/conformance.json",
		"docs",
		"LICENSE",
		"README.md",
		"vendor",
		"test/fixtures/wallet-validation.json"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		}
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"lint": "eslint src && prettier --check src test scripts examples package.json tsconfig.json eslint.config.js --ignore-unknown --no-error-on-unmatched-pattern",
		"test": "npm run build && node --test test/*.test.mjs",
		"prepublishOnly": "npm run build",
		"format": "prettier --write src test scripts examples package.json tsconfig.json eslint.config.js --ignore-unknown --no-error-on-unmatched-pattern",
		"prepare:sdk": "node scripts/prepare-sdk.mjs",
		"test:package": "npm run build && node scripts/package-smoke.mjs"
	},
	"devDependencies": {
		"@emurgo/cardano-message-signing-nodejs": "^1.1.0",
		"@noble/curves": "^2.4.0",
		"@stellar/stellar-sdk": "^17.1.0",
		"@types/node": "^22.20.3",
		"better-auth": "^1.7.5",
		"better-sqlite3": "^13.0.3",
		"bip322-js": "^4.0.0",
		"bitcoinjs-message": "^2.2.0",
		"cborg": "^6.1.2",
		"eslint": "^10.10.0",
		"prettier": "^3.9.6",
		"ripple-keypairs": "^3.1.0",
		"tronweb": "^6.5.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.70.0",
		"viem": "^2.56.5",
		"@typescript/native": "npm:typescript@^7.0.2"
	},
	"dependencies": {
		"@better-fetch/fetch": "^1.3.2",
		"blockchain-wallet-validator": "1.2.1",
		"connect-protocol": "file:vendor/connect-protocol-0.1.1.tgz",
		"monero-ts": "^0.11.15",
		"zod": "^4.6.5",
		"@scure/base": "^2.4.0",
		"@noble/hashes": "^2.4.0"
	},
	"peerDependencies": {
		"better-auth": "^1.7.0"
	},
	"bundleDependencies": [
		"connect-protocol",
		"monero-ts"
	],
	"overrides": {
		"monero-ts": {
			"serialize-javascript": "^7.1.1",
			"uuid": "^11.1.1"
		}
	}
}
